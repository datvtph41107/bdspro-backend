# OS / debugger
.DS_Store
Thumbs.db
__debug_bin*
**/__debug_bin*

# Build/cache/runtime artifacts
**/bin/
**/.tmp/
**/tmp/
**/*.log
**/coverage.out
**/*.rdb
**/app/logs/

# Generated source reconstructed from canonical repository contracts.
/shared/protobuf/types/

# Generated acceptance evidence. Recreate from the Git index immediately before packaging.
/SOURCE-MANIFEST.sha256

# Legacy binaries previously written beside source. Canonical builds use bin/.
/*-service/*-service
/user-service/user
/crm-service/crm
/tqd-service/tqd

# Runtime/local configuration. `make setup` recreates canonical .env files.
**/.env
**/.env.local
**/.env.runtime
**/config/product.yml
**/config/production.yml

# Repository-managed local tools/state
/.work/
/.tools/

# IDE: keep only shared project configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Runtime data / local research
/research/
/tqd-service/files/
