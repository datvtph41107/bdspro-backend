{
    "swagger": "2.0",
    "info": {
        "description": "This is a sample API",
        "title": "Example API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/map",
    "paths": {
        "/locations/find-by-polygon": {
            "post": {
                "description": "Tìm các điểm nằm trong một vùng đa giác",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Locations"
                ],
                "summary": "Tìm địa điểm theo vùng (polygon)",
                "parameters": [
                    {
                        "description": "Danh sách tọa độ tạo thành vùng đa giác",
                        "name": "polygon",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.MapPointDTO"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.MapPointDTO"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/locations/nearby": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Trả về danh sách các điểm gần tọa độ đã cho trong phạm vi bán kính",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Locations"
                ],
                "summary": "Tìm các địa điểm lân cận",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Vĩ độ",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "description": "Kinh độ",
                        "name": "lng",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "default": 5,
                        "description": "Bán kính tìm kiếm (mặc định: 5km)",
                        "name": "radius",
                        "in": "query"
                    }
                ],
                "responses": {}
            }
        },
        "/locations/new": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Thêm một điểm mới vào cơ sở dữ liệu",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Locations"
                ],
                "summary": "Thêm địa điểm mới",
                "parameters": [
                    {
                        "description": "Thông tin địa điểm",
                        "name": "location",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.MapPointDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.MapPointDTO": {
            "description": "Thông tin điểm trên bản đồ",
            "type": "object",
            "properties": {
                "lat": {
                    "type": "number"
                },
                "lng": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}