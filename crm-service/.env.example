# Runtime config
ENV_RUNTIME=local

# Database migration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/db_crm?sslmode=disable

# SEO
SEO_PUBLIC_BASE_URL=http://localhost:3000
SEO_INTERNAL_SECRET_KEY=change-me
SEO_TIMEZONE=Asia/Ho_Chi_Minh
SEO_GENERATION_JOB_ENABLED=true
SEO_GENERATION_JOB_BATCH_SIZE=100
SEO_SITEMAP_DEFAULT_CHANGE_FREQ=daily
SEO_SITEMAP_DEFAULT_PRIORITY=0.5