{
  "version": 8,
  "name": "Basic preview",
  "metadata": {
    "openmaptiles:version": "3.x"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "{{domain_api}}/v2/tqd/qh/public/json/vietnam"
    }
  },
  "glyphs": "{{domain_api}}/v2/tqd/qh/public/font/{fontstack}/{range}.pbf",
