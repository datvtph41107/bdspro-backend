    {
      "id": "background",
      "paint": {
        "background-color": "#f9f9f9"
      },
      "type": "background"
    },
    {
      "filter": [
        "all",
        ["==", "$type", "Polygon"],
        ["in", "class", "residential", "suburb", "neighbourhood"]
      ],
      "id": "landuse-residential",
      "paint": {
        "fill-color": "#f7efdd",
        "fill-opacity": 0.7
      },
      "source": "openmaptiles",
      "source-layer": "landuse",
      "type": "fill"
    },
    {
      "filter": ["==", "class", "grass"],
      "id": "landcover_grass",
      "paint": {
        "fill-color": "#c2f0d4",
        "fill-opacity": 0.9
      },
      "source": "openmaptiles",
      "source-layer": "landcover",
      "type": "fill"
    },
    {
      "filter": ["==", "class", "wood"],
      "id": "landcover_wood",
      "paint": {
        "fill-color": "#b8efcf",
