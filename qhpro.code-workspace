{
  "folders": [
    {"name": "BACKEND", "path": "."},
    {"name": "ADMIN", "path": "../react-js-admin-bds"},
    {"name": "CLIENT", "path": "../react-native-quy-hoach"}
  ],
  "settings": {
    "editor.formatOnSave": true,
    "files.exclude": {
      "**/.git": true,
      "**/.tools": true,
      "**/.work": true,
      "**/bin": true,
      "**/dist": true,
      "**/node_modules": true
    },
    "files.watcherExclude": {
      "**/.git/**": true,
      "**/.tools/**": true,
      "**/.work/**": true,
      "**/dist/**": true,
      "**/node_modules/**": true
    },
    "search.exclude": {
      "**/.tools/**": true,
      "**/.work/**": true,
      "**/dist/**": true,
      "**/node_modules/**": true,
      "**/*.pb.go": true,
      "**/*_grpc.pb.go": true
    },
    "[go]": {
      "editor.defaultFormatter": "golang.go",
      "editor.formatOnSave": true
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "golang.go",
      "ms-azuretools.vscode-docker",
      "zxh404.vscode-proto3"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "QHPRO · Configure",
        "type": "process",
        "command": "make",
        "args": ["configure"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": []
      },
      {
        "label": "QHPRO · Doctor",
        "type": "process",
        "command": "make",
        "args": ["doctor"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": []
      },
      {
        "label": "Backend · Up",
        "type": "process",
        "command": "make",
        "args": ["dev-up"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": [],
        "presentation": {"group": "backend", "panel": "dedicated", "reveal": "always"}
      },
      {
        "label": "Backend · Status",
        "type": "process",
        "command": "make",
        "args": ["dev-status"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": []
      },
      {
        "label": "Backend · Smoke",
        "type": "process",
        "command": "make",
        "args": ["dev-smoke"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": []
      },
      {
        "label": "Backend · Verify",
        "type": "process",
        "command": "make",
        "args": ["verify-backend"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": ["$go"]
      },
      {
        "label": "Backend · Logs",
        "type": "process",
        "command": "make",
        "args": ["dev-logs"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {"group": "backend-logs", "panel": "dedicated", "reveal": "always"}
      },
      {
        "label": "Backend · Down",
        "type": "process",
        "command": "make",
        "args": ["dev-down"],
        "options": {"cwd": "${workspaceFolder:BACKEND}"},
        "problemMatcher": []
      },
      {
        "label": "Admin · Dev",
        "type": "process",
        "command": "npm",
        "args": ["run", "dev"],
        "options": {"cwd": "${workspaceFolder:ADMIN}"},
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {"group": "admin", "panel": "dedicated", "reveal": "always"}
      },
      {
        "label": "Admin · Verify Commercial",
        "type": "process",
        "command": "npm",
        "args": ["run", "verify:commercial-admin"],
        "options": {"cwd": "${workspaceFolder:ADMIN}"},
        "problemMatcher": []
      },
      {
        "label": "Client · Web",
        "type": "process",
        "command": "npm",
        "args": ["run", "web"],
        "options": {"cwd": "${workspaceFolder:CLIENT}"},
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {"group": "client", "panel": "dedicated", "reveal": "always"}
      },
      {
        "label": "Client · Verify Commercial",
        "type": "process",
        "command": "npm",
        "args": ["run", "verify:commercial-flow"],
        "options": {"cwd": "${workspaceFolder:CLIENT}"},
        "problemMatcher": []
      }
    ]
  }
}
